{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adventureworks-github-dataingestion-DF"
		},
		"adventureworks_adls_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adventureworksgithub.dfs.core.windows.net/"
		},
		"adventureworks_errorlogging_sqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adventureworks-github-server.database.windows.net"
		},
		"adventureworks_errorlogging_sqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "adventureworks-github"
		},
		"adventureworks_errorlogging_sqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "smc_05mar26"
		},
		"adventureworks_errorlogging_sqldb_KV_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://adventureworks-github.vault.azure.net/"
		},
		"github_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Data-Ingestion')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "parameters-lookup",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"dataset": {
								"referenceName": "parameters_lookup_DS",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEach1",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "parameters-lookup",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('parameters-lookup').output.value",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "copy_github_data",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "DelimitedTextSource",
											"storeSettings": {
												"type": "HttpReadSettings",
												"requestMethod": "GET"
											},
											"formatSettings": {
												"type": "DelimitedTextReadSettings"
											}
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"enableSkipIncompatibleRow": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "github_files_DS",
											"type": "DatasetReference",
											"parameters": {
												"p_file_url": {
													"value": "@item().p_file_url",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "adls_adventureworks_csv_DS",
											"type": "DatasetReference",
											"parameters": {
												"p_folder_name": {
													"value": "@item().p_folder_name",
													"type": "Expression"
												},
												"p_file_name": {
													"value": "@item().p_file_name",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "error-log",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [
										{
											"activity": "copy_github_data",
											"dependencyConditions": [
												"Failed"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "[[dbo].[log_pipeline_error]",
										"storedProcedureParameters": {
											"pipeline_name": {
												"value": {
													"value": "@pipeline().Pipeline",
													"type": "Expression"
												},
												"type": "String"
											},
											"activity_name": {
												"value": {
													"value": "`copy_github_data`",
													"type": "Expression"
												},
												"type": "String"
											},
											"file_name": {
												"value": {
													"value": "@item().p_file_name",
													"type": "Expression"
												},
												"type": "String"
											},
											"folder_name": {
												"value": {
													"value": "@item().p_folder_name",
													"type": "Expression"
												},
												"type": "String"
											},
											"error_message": {
												"value": {
													"value": "@activity('copy_github_data').error.message",
													"type": "Expression"
												},
												"type": "String"
											},
											"status": {
												"value": "`Failed`",
												"type": "String"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "adventureworks_errorlogging_sqldb",
										"type": "LinkedServiceReference"
									}
								},
								{
									"name": "success-log",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [
										{
											"activity": "copy_github_data",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "[[dbo].[log_pipeline_success]",
										"storedProcedureParameters": {
											"pipeline_name": {
												"value": {
													"value": "@pipeline().Pipeline",
													"type": "Expression"
												},
												"type": "String"
											},
											"activity_name": {
												"value": {
													"value": "`copy_github_data`",
													"type": "Expression"
												},
												"type": "String"
											},
											"file_name": {
												"value": {
													"value": "@item().p_file_name",
													"type": "Expression"
												},
												"type": "String"
											},
											"folder_name": {
												"value": {
													"value": "@item().p_folder_name",
													"type": "Expression"
												},
												"type": "String"
											},
											"error_message": {
												"value": {
													"value": "'Null'",
													"type": "Expression"
												},
												"type": "String"
											},
											"status": {
												"value": {
													"value": "`Success`",
													"type": "Expression"
												},
												"type": "String"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "adventureworks_errorlogging_sqldb",
										"type": "LinkedServiceReference"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/parameters_lookup_DS')]",
				"[concat(variables('factoryId'), '/datasets/github_files_DS')]",
				"[concat(variables('factoryId'), '/datasets/adls_adventureworks_csv_DS')]",
				"[concat(variables('factoryId'), '/linkedServices/adventureworks_errorlogging_sqldb')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/adls_adventureworks_csv_DS')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "adventureworks_adls_LS",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_folder_name": {
						"type": "string"
					},
					"p_file_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().p_file_name",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().p_folder_name",
							"type": "Expression"
						},
						"fileSystem": "bronze"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/adventureworks_adls_LS')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/github_files_DS')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "github_LS",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_file_url": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "HttpServerLocation",
						"relativeUrl": {
							"value": "@dataset().p_file_url",
							"type": "Expression"
						}
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/github_LS')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/parameters_lookup_DS')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "adventureworks_adls_LS",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "adventureworks-parameters.json",
						"fileSystem": "config"
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/adventureworks_adls_LS')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/adventureworks_adls_LS')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('adventureworks_adls_LS_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/adventureworks_errorlogging_sqldb')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('adventureworks_errorlogging_sqldb_properties_typeProperties_server')]",
					"database": "[parameters('adventureworks_errorlogging_sqldb_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('adventureworks_errorlogging_sqldb_properties_typeProperties_userName')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "adventureworks_errorlogging_sqldb_KV",
							"type": "LinkedServiceReference"
						},
						"secretName": "adventureworks-github-sqldb-pwd"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/adventureworks_errorlogging_sqldb_KV')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/adventureworks_errorlogging_sqldb_KV')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('adventureworks_errorlogging_sqldb_KV_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/github_LS')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "HttpServer",
				"typeProperties": {
					"url": "[parameters('github_LS_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous"
				}
			},
			"dependsOn": []
		}
	]
}