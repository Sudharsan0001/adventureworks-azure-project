{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adventureworks-github-dataingestion-DF"
		},
		"adventureworks_adls_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adventureworksgithub.dfs.core.windows.net/"
		},
		"adventureworks_errorlogging_sqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adventureworks-github-server.database.windows.net"
		},
		"adventureworks_errorlogging_sqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "adventureworks-github"
		},
		"adventureworks_errorlogging_sqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "smc_05mar26"
		},
		"adventureworks_errorlogging_sqldb_KV_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://adventureworks-github.vault.azure.net/"
		},
		"github_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adventureworks-github-dataingestion-DF_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"adventureworks_adls_LS_properties_typeProperties_url": {
						"value": "[parameters('adventureworks_adls_LS_properties_typeProperties_url')]"
					},
					"adventureworks_errorlogging_sqldb_KV_properties_typeProperties_baseUrl": {
						"value": "[parameters('adventureworks_errorlogging_sqldb_KV_properties_typeProperties_baseUrl')]"
					},
					"github_LS_properties_typeProperties_url": {
						"value": "[parameters('github_LS_properties_typeProperties_url')]"
					},
					"adventureworks_errorlogging_sqldb_properties_typeProperties_server": {
						"value": "[parameters('adventureworks_errorlogging_sqldb_properties_typeProperties_server')]"
					},
					"adventureworks_errorlogging_sqldb_properties_typeProperties_database": {
						"value": "[parameters('adventureworks_errorlogging_sqldb_properties_typeProperties_database')]"
					},
					"adventureworks_errorlogging_sqldb_properties_typeProperties_userName": {
						"value": "[parameters('adventureworks_errorlogging_sqldb_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}