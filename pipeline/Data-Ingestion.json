{
	"name": "Data-Ingestion",
	"properties": {
		"activities": [
			{
				"name": "parameters-lookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "parameters_lookup_DS",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "parameters-lookup",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('parameters-lookup').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "copy_github_data",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"enableSkipIncompatibleRow": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "github_files_DS",
									"type": "DatasetReference",
									"parameters": {
										"p_file_url": {
											"value": "@item().p_file_url",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "adls_adventureworks_csv_DS",
									"type": "DatasetReference",
									"parameters": {
										"p_folder_name": {
											"value": "@item().p_folder_name",
											"type": "Expression"
										},
										"p_file_name": {
											"value": "@item().p_file_name",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "error-log",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "copy_github_data",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[log_pipeline_error]",
								"storedProcedureParameters": {
									"pipeline_name": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"activity_name": {
										"value": {
											"value": "`copy_github_data`",
											"type": "Expression"
										},
										"type": "String"
									},
									"file_name": {
										"value": {
											"value": "@item().p_file_name",
											"type": "Expression"
										},
										"type": "String"
									},
									"folder_name": {
										"value": {
											"value": "@item().p_folder_name",
											"type": "Expression"
										},
										"type": "String"
									},
									"error_message": {
										"value": {
											"value": "@activity('copy_github_data').error.message",
											"type": "Expression"
										},
										"type": "String"
									},
									"status": {
										"value": "`Failed`",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "adventureworks_errorlogging_sqldb",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "success-log",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "copy_github_data",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[log_pipeline_success]",
								"storedProcedureParameters": {
									"pipeline_name": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"activity_name": {
										"value": {
											"value": "`copy_github_data`",
											"type": "Expression"
										},
										"type": "String"
									},
									"file_name": {
										"value": {
											"value": "@item().p_file_name",
											"type": "Expression"
										},
										"type": "String"
									},
									"folder_name": {
										"value": {
											"value": "@item().p_folder_name",
											"type": "Expression"
										},
										"type": "String"
									},
									"error_message": {
										"value": {
											"value": "'Null'",
											"type": "Expression"
										},
										"type": "String"
									},
									"status": {
										"value": {
											"value": "`Success`",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "adventureworks_errorlogging_sqldb",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}